/*
  ESP32-C3 SuperMini Wristband: MPU6500 + Joystick -> ESP-NOW -> USB receiver ESP32
  ---------------------------------------------------------------------------------
  MPU6500 : SDA = GPIO8, SCL = GPIO9 (I2C addr 0x68)
  Blue LED: GPIO10 (through a resistor to GND)
  Button  : GPIO2 to GND (internal pull-up)
  Motor LEDs: GPIO3 (green = forward), GPIO4 (red = backward), PWM
  Motor driver: GPIO6 = IN1 (forward PWM), GPIO7 = IN2 (backward PWM)
  Joystick: VRx = GPIO0, VRy = GPIO1 (VCC to 3V3, not 5V)
  Joystick click: SW = GPIO5 to GND (internal pull-up). Left glove click = E (interact), right glove click = V (hold to talk).
  HAND_ID: build one sketch with 0 for the LEFT glove and another with 1 for the RIGHT glove.

  Arduino IDE: Board = ESP32C3 Dev Module, Tools > USB CDC On Boot > ENABLED

  Button:
    Short press = connect / disconnect
    Hold 3 sec  = re-calibrate sensor (keep band still and flat)

  Blue LED:
    Flashing   = not connected to receiver
    Solid      = connected
    Fast flash = calibrating / MPU error

  Motor: sweeps smoothly forward -> backward -> forward while connected.
         Strength and speed increase with movement.
*/

#include <Arduino.h>
#include <Wire.h>
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <esp_idf_version.h>

// ===================== USER SETTINGS =====================
// Receiver MAC a0:b7:65:0f:4d:1c
uint8_t RECEIVER_MAC[6] = {0xA0, 0xB7, 0x65, 0x0F, 0x4D, 0x1C};
const uint8_t ESPNOW_CHANNEL = 1;          // must match the receiver

const bool AUTO_CONNECT_ON_BOOT = true;

// ===================== PINS (ESP32-C3 SuperMini) =====================
#define PIN_SDA     8
#define PIN_SCL     9
#define PIN_B       10   // blue LED
#define PIN_BUTTON  2
#define PIN_MOTOR1  3    // green LED = forward
#define PIN_MOTOR2  4    // red LED   = backward
#define PIN_DRV_IN1 6    // motor driver forward PWM
#define PIN_DRV_IN2 7    // motor driver backward PWM
#define PIN_JOY_X   0    // VRx (ADC1)
#define PIN_JOY_Y   1    // VRy (ADC1)
#define PIN_JOY_SW  5    // joystick push-button (to GND)

// Which glove is this? 0 = LEFT (moves, click = E), 1 = RIGHT (looks, click = V)
#ifndef HAND_ID            // scripts/flash-gloves.sh passes -DHAND_ID=0 for the left glove
#define HAND_ID 1
#endif

// Set to true if the LED is wired to 3.3V instead of GND (active low)
#define LED_ACTIVE_LOW false

// ===================== MPU6500 =====================
#define MPU_ADDR        0x68
#define REG_SMPLRT_DIV  0x19
#define REG_CONFIG      0x1A
#define REG_GYRO_CFG    0x1B
#define REG_ACCEL_CFG   0x1C
#define REG_ACCEL_CFG2  0x1D
#define REG_ACCEL_XOUT  0x3B
#define REG_PWR_MGMT_1  0x6B
#define REG_WHO_AM_I    0x75

// +-4 g and +-500 dps
const float ACCEL_LSB_PER_G  = 8192.0;
const float GYRO_LSB_PER_DPS = 65.5;

const uint32_t SAMPLE_PERIOD_US = 5000;   // 200 Hz sampling
const uint32_t SEND_PERIOD_MS   = 20;     // 50 Hz to receiver
const uint32_t PRINT_PERIOD_MS  = 100;    // 10 Hz serial print

// ===================== PWM =====================
const int PWM_FREQ = 5000;   // use 20000 if the motor whines
const int PWM_RES  = 8;      // 0-255

// ===================== PACKETS =====================
typedef struct __attribute__((packed)) {
  uint8_t type;                       // 1=hello, 2=data, 3=bye
  float ax, ay, az, gx, gy, gz, batt;
  uint32_t t;
  int16_t jx, jy;                     // joystick -100..+100
  int16_t jxRaw, jyRaw;               // joystick raw 0..4095
  float actA, actG;                   // accel / gyro activity 0..1
  uint8_t hand;                       // 0 = left glove, 1 = right glove
  uint8_t btn;                        // joystick click: 1 = pressed
} DataPkt;

typedef struct __attribute__((packed)) {
  uint8_t cmd;                        // 1=calibrate, 2=disconnect, 3=motor scale, 4=connect
  float value;
} CmdPkt;

// ===================== STATE =====================
float axOff = 0, ayOff = 0, azOff = 0;
float gxOff = 0, gyOff = 0, gzOff = 0;

float ax, ay, az, gx, gy, gz;            // calibrated values (g, dps)

double sAx = 0, sAy = 0, sAz = 0, sGx = 0, sGy = 0, sGz = 0;
int sCount = 0;

float accelActivity = 0, gyroActivity = 0;   // smoothed 0..1

bool connectedToServer = false;
float battVoltage = 0;         // sent as 0.00 (battery check removed)
float motorScale = 1.0;

float    motorLevel = 0;       // smoothed 0..255
float    motorPhase = 0;       // 0..2*PI position in the forward/backward cycle
uint32_t lastMotorMs = 0;

volatile int     failCount = 0;
volatile bool    sendDone = false, sendOk = false;
volatile uint8_t pendingCmd = 0;
volatile float   pendingValue = 0;

uint32_t lastSampleUs = 0, lastSendMs = 0, lastPrintMs = 0;

// button
bool btnLast = HIGH;
uint32_t btnDownMs = 0;
bool btnLongHandled = false;

// joystick
int joyXRaw = 0, joyYRaw = 0;          // 0..4095
int joyXCenter = 2048, joyYCenter = 2048;
int joyXPct = 0, joyYPct = 0;          // -100..+100
bool joyClick = false;                 // debounced joystick push-button
uint8_t joyClickRaw = 0; uint32_t joyClickChangeMs = 0;
const int JOY_DEADZONE_PCT = 5;
uint32_t lastJoyMs = 0;

// ===================== PWM HELPERS =====================
// Core 2.x: channels are assigned in call order (0,1,2,3).
// pwmSetup order in setup(): MOTOR1, MOTOR2, DRV_IN1, DRV_IN2
void pwmSetup(int pin) {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(pin, PWM_FREQ, PWM_RES);
#else
  static int ch = 0;
  ledcSetup(ch, PWM_FREQ, PWM_RES);
  ledcAttachPin(pin, ch);
  ch++;
#endif
}

void pwmWrite(int pin, int ch, int duty) {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(pin, duty);
#else
  ledcWrite(ch, duty);
#endif
}

void setMotors(int d1, int d2) {
  pwmWrite(PIN_MOTOR1, 0, d1);     // green LED  = forward
  pwmWrite(PIN_MOTOR2, 1, d2);     // red LED    = backward
  pwmWrite(PIN_DRV_IN1, 2, d1);    // motor driver IN1
  pwmWrite(PIN_DRV_IN2, 3, d2);    // motor driver IN2
}

void updateMotors() {
  if (!connectedToServer) {
    motorLevel = 0;
    setMotors(0, 0);
    return;
  }

  float activity = max(accelActivity, gyroActivity);   // 0..1
  uint32_t ms = millis();
  float dt = (ms - lastMotorMs) / 1000.0f;
  lastMotorMs = ms;
  if (dt > 0.1f) dt = 0.1f;                            // ignore long stalls

  // Full forward+backward cycle: 1.5 s when calm -> 0.4 s with hard movement
  float period = 1.5f - activity * 1.1f;
  motorPhase += 2.0f * PI * dt / period;
  if (motorPhase > 2.0f * PI) motorPhase -= 2.0f * PI;

  // Strength follows how much you move (smoothed)
  float target = activity * 255.0f * motorScale;
  motorLevel += 0.25f * (target - motorLevel);

  float s = sinf(motorPhase);                          // +1 forward ... -1 backward
  int duty = constrain((int)(fabsf(s) * motorLevel), 0, 255);

  if (s >= 0) setMotors(duty, 0);                      // forward  (GPIO6 + green LED)
  else        setMotors(0, duty);                      // backward (GPIO7 + red LED)
}

// ===================== BLUE LED =====================
void setBlue(bool on) {
  digitalWrite(PIN_B, (on != LED_ACTIVE_LOW) ? HIGH : LOW);
}

void updateLED() {
  if (connectedToServer) {
    setBlue(true);                            // solid
  } else {
    setBlue((millis() / 500) % 2);            // flashing
  }
}

// ===================== JOYSTICK =====================
int joyAvg(int pin, int n) {
  long s = 0;
  for (int i = 0; i < n; i++) { s += analogRead(pin); delay(2); }
  return (int)(s / n);
}

void joyCalibrate() {
  // Leave the stick untouched (centered) while this runs
  joyXCenter = joyAvg(PIN_JOY_X, 50);
  joyYCenter = joyAvg(PIN_JOY_Y, 50);
  Serial.printf("Joystick center: X=%d Y=%d\n", joyXCenter, joyYCenter);
}

int joyToPct(int raw, int center) {
  int pct;
  if (raw >= center) pct = (raw - center) * 100 / max(1, 4095 - center);
  else               pct = (raw - center) * 100 / max(1, center);
  pct = constrain(pct, -100, 100);
  if (abs(pct) < JOY_DEADZONE_PCT) pct = 0;
  return pct;
}

void readJoystick() {
  // average 4 reads to reduce ADC noise
  long sx = 0, sy = 0;
  for (int i = 0; i < 4; i++) { sx += analogRead(PIN_JOY_X); sy += analogRead(PIN_JOY_Y); }
  joyXRaw = sx / 4;
  joyYRaw = sy / 4;
  joyXPct = joyToPct(joyXRaw, joyXCenter);
  joyYPct = joyToPct(joyYRaw, joyYCenter);
  // push-button: pressed = LOW, 30 ms debounce
  uint8_t raw = digitalRead(PIN_JOY_SW) == LOW ? 1 : 0;
  uint32_t nowMs = millis();
  if (raw != joyClickRaw) { joyClickRaw = raw; joyClickChangeMs = nowMs; }
  else if (nowMs - joyClickChangeMs >= 30) joyClick = raw;
}

// ===================== MPU6500 =====================
void mpuWrite(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

uint8_t mpuRead8(uint8_t reg) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);
  Wire.requestFrom((uint8_t)MPU_ADDR, (uint8_t)1);
  return Wire.available() ? Wire.read() : 0xFF;
}

bool mpuBegin() {
  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(400000);

  uint8_t id = mpuRead8(REG_WHO_AM_I);
  Serial.printf("WHO_AM_I = 0x%02X (MPU6500 expects 0x70)\n", id);
  if (id != 0x70 && id != 0x71 && id != 0x73) {
    Serial.println("WARNING: unexpected WHO_AM_I, continuing anyway if device responds.");
    if (id == 0xFF) return false;
  }

  mpuWrite(REG_PWR_MGMT_1, 0x80);   // reset
  delay(100);
  mpuWrite(REG_PWR_MGMT_1, 0x01);   // wake, PLL with gyro X clock
  delay(50);
  mpuWrite(REG_SMPLRT_DIV, 0x00);   // 1 kHz internal
  mpuWrite(REG_CONFIG, 0x03);       // gyro DLPF ~41 Hz
  mpuWrite(REG_GYRO_CFG, 0x08);     // +-500 dps
  mpuWrite(REG_ACCEL_CFG, 0x08);    // +-4 g
  mpuWrite(REG_ACCEL_CFG2, 0x03);   // accel DLPF ~44 Hz
  delay(50);
  return true;
}

bool mpuReadRaw(int16_t* r) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(REG_ACCEL_XOUT);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)MPU_ADDR, (uint8_t)14) != 14) return false;
  for (int i = 0; i < 7; i++) {
    uint8_t h = Wire.read();
    uint8_t l = Wire.read();
    r[i] = (int16_t)((h << 8) | l);
  }
  // r: 0-2 accel, 3 temp, 4-6 gyro
  return true;
}

void calibrateMPU() {
  Serial.printf("Calibrating at %lu ms... keep the band STILL and FLAT (Z up).\n", millis());
  setBlue(false);
  setMotors(0, 0);
  delay(1000);

  const int N = 1500;
  double sax = 0, say = 0, saz = 0, sgx = 0, sgy = 0, sgz = 0;
  int16_t r[7];
  int good = 0;

  for (int i = 0; i < N; i++) {
    if (i % 50 == 0) setBlue((i / 50) % 2);   // fast blue flash while calibrating
    if (mpuReadRaw(r)) {
      sax += r[0]; say += r[1]; saz += r[2];
      sgx += r[4]; sgy += r[5]; sgz += r[6];
      good++;
    }
    delay(3);
  }
  if (good < 100) {
    Serial.println("Calibration failed: not enough samples.");
    return;
  }
  axOff = (sax / good) / ACCEL_LSB_PER_G;
  ayOff = (say / good) / ACCEL_LSB_PER_G;
  azOff = (saz / good) / ACCEL_LSB_PER_G - 1.0;     // remove 1 g gravity on Z
  gxOff = (sgx / good) / GYRO_LSB_PER_DPS;
  gyOff = (sgy / good) / GYRO_LSB_PER_DPS;
  gzOff = (sgz / good) / GYRO_LSB_PER_DPS;

  // clear any averaging accumulated before calibration
  sAx = sAy = sAz = sGx = sGy = sGz = 0;
  sCount = 0;

  Serial.println("Calibration done.");
  Serial.printf("Accel offsets (g):   %.4f %.4f %.4f\n", axOff, ayOff, azOff);
  Serial.printf("Gyro offsets (dps):  %.4f %.4f %.4f\n", gxOff, gyOff, gzOff);
}

// ===================== ESP-NOW =====================
void handleSent(bool ok) {
  sendOk = ok;
  sendDone = true;
  if (ok) failCount = 0; else failCount = failCount + 1;
}

void handleRecv(const uint8_t* d, int len) {
  if (len != (int)sizeof(CmdPkt)) return;
  CmdPkt c;
  memcpy(&c, d, sizeof(c));
  pendingValue = c.value;
  pendingCmd = c.cmd;                 // handled in loop(), not in the callback
}

// Send callback signature changed in newer IDF versions
#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 5, 0)
void onSent(const wifi_tx_info_t*, esp_now_send_status_t s) { handleSent(s == ESP_NOW_SEND_SUCCESS); }
#else
void onSent(const uint8_t*, esp_now_send_status_t s) { handleSent(s == ESP_NOW_SEND_SUCCESS); }
#endif

#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 0, 0)
void onRecv(const esp_now_recv_info_t*, const uint8_t* d, int len) { handleRecv(d, len); }
#else
void onRecv(const uint8_t*, const uint8_t* d, int len) { handleRecv(d, len); }
#endif

bool espNowBegin() {
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();
  WiFi.setTxPower(WIFI_POWER_8_5dBm);   // SuperMini boards often work better at reduced power
  esp_wifi_set_channel(ESPNOW_CHANNEL, WIFI_SECOND_CHAN_NONE);
  if (esp_now_init() != ESP_OK) return false;
  esp_now_register_send_cb(onSent);
  esp_now_register_recv_cb(onRecv);

  esp_now_peer_info_t peer = {};
  memcpy(peer.peer_addr, RECEIVER_MAC, 6);
  peer.channel = ESPNOW_CHANNEL;
  peer.encrypt = false;
  return esp_now_add_peer(&peer) == ESP_OK;
}

bool sendAndWait(const DataPkt& p) {
  sendDone = false;
  if (esp_now_send(RECEIVER_MAC, (const uint8_t*)&p, sizeof(p)) != ESP_OK) return false;
  uint32_t t = millis();
  while (!sendDone && millis() - t < 150) delay(1);
  return sendDone && sendOk;
}

void connectToServer() {
  DataPkt p = {};
  p.type = 1;
  connectedToServer = sendAndWait(p);
  failCount = 0;
  Serial.println(connectedToServer ? ">>> Connected to receiver" : ">>> Receiver not reachable");
}

void disconnectFromServer() {
  if (connectedToServer) {
    DataPkt p = {};
    p.type = 3;
    sendAndWait(p);
  }
  connectedToServer = false;
  setMotors(0, 0);
  Serial.println(">>> Disconnected");
}

void sendData() {
  if (!connectedToServer || sCount == 0) return;

  DataPkt p = {};
  p.type = 2;
  p.ax = sAx / sCount; p.ay = sAy / sCount; p.az = sAz / sCount;
  p.gx = sGx / sCount; p.gy = sGy / sCount; p.gz = sGz / sCount;
  p.batt = battVoltage;
  p.t = millis();
  p.jx = joyXPct;      p.jy = joyYPct;
  p.jxRaw = joyXRaw;   p.jyRaw = joyYRaw;
  p.actA = accelActivity;
  p.actG = gyroActivity;
  p.hand = HAND_ID;
  p.btn = joyClick ? 1 : 0;

  sAx = sAy = sAz = sGx = sGy = sGz = 0;
  sCount = 0;

  esp_now_send(RECEIVER_MAC, (const uint8_t*)&p, sizeof(p));

  if (failCount >= 10) {
    Serial.println("Lost connection to receiver.");
    connectedToServer = false;
    setMotors(0, 0);
  }
}

void handlePendingCommand() {
  uint8_t c = pendingCmd;
  if (!c) return;
  pendingCmd = 0;
  if (c == 1) calibrateMPU();
  else if (c == 2) disconnectFromServer();
  else if (c == 3) motorScale = constrain((float)pendingValue, 0.0f, 1.0f);
  else if (c == 4) connectToServer();
}

// ===================== BUTTON =====================
void handleButton() {
  bool now = digitalRead(PIN_BUTTON);
  uint32_t ms = millis();

  if (btnLast == HIGH && now == LOW) {          // pressed
    delay(20);                                  // debounce
    if (digitalRead(PIN_BUTTON) == LOW) {
      btnDownMs = ms;
      btnLongHandled = false;
      btnLast = LOW;
    }
  } else if (btnLast == LOW && now == LOW) {    // held
    if (!btnLongHandled && ms - btnDownMs >= 3000) {
      btnLongHandled = true;
      calibrateMPU();
    }
  } else if (btnLast == LOW && now == HIGH) {   // released
    delay(20);
    if (digitalRead(PIN_BUTTON) == HIGH) {
      if (!btnLongHandled) {                    // short press
        if (connectedToServer) disconnectFromServer();
        else connectToServer();
      }
      btnLast = HIGH;
    }
  }
}

// ===================== SETUP =====================
void setup() {
  Serial.begin(115200);
  Serial.setTxTimeoutMs(0);          // never stall when no computer is reading (battery / power-only use)
  uint32_t t0 = millis();
  while (!Serial && millis() - t0 < 1500) delay(10);   // wait briefly for USB CDC
  Serial.println("\n=== ESP32-C3 Wristband ===");

  esp_reset_reason_t rr = esp_reset_reason();
  Serial.printf("Reset reason: %d (1=power-on, 4=panic, 5/6=watchdog, 15=BROWNOUT)\n", (int)rr);

  pinMode(PIN_B, OUTPUT);
  pinMode(PIN_BUTTON, INPUT_PULLUP);
  pinMode(PIN_JOY_SW, INPUT_PULLUP);
  setBlue(false);

  analogReadResolution(12);
  analogSetPinAttenuation(PIN_JOY_X, ADC_11db);
  analogSetPinAttenuation(PIN_JOY_Y, ADC_11db);

  // Order matters on core 2.x (channels 0,1,2,3)
  pwmSetup(PIN_MOTOR1);
  pwmSetup(PIN_MOTOR2);
  pwmSetup(PIN_DRV_IN1);
  pwmSetup(PIN_DRV_IN2);
  setMotors(0, 0);

  randomSeed(esp_random());

  if (!mpuBegin()) {
    Serial.println("MPU6500 not found! Check wiring (SDA=GPIO8, SCL=GPIO9).");
    while (true) {                    // rapid blue flashing forever
      setBlue(true);  delay(100);
      setBlue(false); delay(100);
    }
  }

  calibrateMPU();
  joyCalibrate();                     // keep the joystick centered during boot

  if (!espNowBegin()) Serial.println("ESP-NOW init failed");
  if (AUTO_CONNECT_ON_BOOT) connectToServer();

  lastSampleUs = micros();
  lastMotorMs = millis();
}

// ===================== LOOP =====================
void loop() {
  handlePendingCommand();
  handleButton();

  uint32_t nowUs = micros();
  if (nowUs - lastSampleUs >= SAMPLE_PERIOD_US) {
    lastSampleUs += SAMPLE_PERIOD_US;
    if (nowUs - lastSampleUs > 50000) lastSampleUs = nowUs;   // resync after long stall

    int16_t r[7];
    if (mpuReadRaw(r)) {
      ax = r[0] / ACCEL_LSB_PER_G - axOff;
      ay = r[1] / ACCEL_LSB_PER_G - ayOff;
      az = r[2] / ACCEL_LSB_PER_G - azOff;
      gx = r[4] / GYRO_LSB_PER_DPS - gxOff;
      gy = r[5] / GYRO_LSB_PER_DPS - gyOff;
      gz = r[6] / GYRO_LSB_PER_DPS - gzOff;

      sAx += ax; sAy += ay; sAz += az;
      sGx += gx; sGy += gy; sGz += gz;
      sCount++;

      // ---- movement activity (0..1) ----
      float aMag = sqrtf(ax * ax + ay * ay + az * az);
      float aDyn = fabsf(aMag - 1.0f);                         // g beyond gravity
      float gMag = sqrtf(gx * gx + gy * gy + gz * gz);         // dps

      float aNorm = constrain((aDyn - 0.03f) / 1.0f, 0.0f, 1.0f);    // deadband 0.03 g, full at ~1 g
      float gNorm = constrain((gMag - 5.0f) / 250.0f, 0.0f, 1.0f);   // deadband 5 dps, full at ~250 dps

      // fast attack, slow decay
      accelActivity += (aNorm > accelActivity ? 0.20f : 0.01f) * (aNorm - accelActivity);
      gyroActivity  += (gNorm > gyroActivity  ? 0.20f : 0.01f) * (gNorm - gyroActivity);

      updateMotors();
    }
  }

  uint32_t ms = millis();

  if (ms - lastSendMs >= SEND_PERIOD_MS) {
    lastSendMs = ms;
    sendData();
  }

  if (ms - lastJoyMs >= 20) {      // 50 Hz
    lastJoyMs = ms;
    readJoystick();
  }

  if (ms - lastPrintMs >= PRINT_PERIOD_MS) {
    lastPrintMs = ms;
    if (Serial)                    // only print when a computer is actually listening
    Serial.printf("A[g] %7.3f %7.3f %7.3f | G[dps] %8.2f %8.2f %8.2f | Act %.2f/%.2f | Joy X:%4d (%4d%%) Y:%4d (%4d%%) Click:%d | %s\n",
                  ax, ay, az, gx, gy, gz,
                  accelActivity, gyroActivity,
                  joyXRaw, joyXPct, joyYRaw, joyYPct, joyClick ? 1 : 0,
                  connectedToServer ? "CONNECTED" : "DISCONNECTED");
  }

  updateLED();
}
