# systemd *user* unit for esp_hub. Runs as you (no root), so it needs the same
# serial-port access you have (on Arch: membership in the `uucp` group).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp esp-hub.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now esp-hub      # start now and at every login
#
# Use:
#   systemctl --user status esp-hub
#   journalctl --user -u esp-hub -f            # live log
#   systemctl --user stop esp-hub              # free the port completely
#
# Adjust the path below if the repo is not at ~/fall2026. Add flags such as
# --port /dev/serial/by-id/... to ExecStart if needed.

[Unit]
Description=ESP32 serial hub (one serial port, many clients over TCP/HTTP)

[Service]
ExecStart=/usr/bin/python3 %h/fall2026/hub/esp_hub.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
